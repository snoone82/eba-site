{
  "name": "eba-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "npm run build && react-snap",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react-snap": "^1.23.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": { "collapseWhitespace": false, "removeComments": false },
    "inlineCss": false,
    "waitFor": 1000,
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "include": [
      "/",
      "/academy",
      "/ai-tools",
      "/ai-tools/om-manual",
      "/ai-tools/compliance-chatbot",
      "/about",
      "/mentorship",
      "/pricing",
      "/documents",
      "/contact",
      "/faq",
      "/enterprise",
      "/privacy-policy",
      "/terms",
      "/404"
    ]
  }
}
