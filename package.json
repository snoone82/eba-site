{
  "name": "eba-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prerender": "react-snap",
    "build:static": "npm run build && npm run prerender",
    "build:vercel": "npm run build && (timeout 600 npm run prerender || echo '::warning:: PRERENDER SKIPPED (failed or timed out after 10m) — deploying SPA shell only. Google sees no server-rendered copy. Check this log before launch.')",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@fontsource/inter": "^5.2.8",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.4",
    "puppeteer-core": "^25.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "resend": "^6.17.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react-snap": "^1.23.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": false,
      "removeComments": false
    },
    "inlineCss": false,
    "waitFor": 1000,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--proxy-server=direct://",
      "--proxy-bypass-list=*"
    ],
    "include": [
      "/",
      "/academy",
      "/ai-tools",
      "/ai-tools/om-manual",
      "/ai-tools/compliance-chatbot",
      "/toolbox-talk",
      "/our-story",
      "/mentorship",
      "/pricing",
      "/documents",
      "/contact",
      "/faq",
      "/enterprise",
      "/privacy-policy",
      "/terms",
      "/404"
    ],
    "concurrency": 16,
    "skipThirdPartyRequests": true
  }
}