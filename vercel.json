{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.teb-academy.com"
        }
      ],
      "destination": "https://teb-academy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/generate-toolbox-talk.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/generate-rams.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/generate-coshh.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/doc-dl-procedures.ts": {
      "includeFiles": "api/_documents/procedures/**"
    },
    "api/doc-dl-templates.ts": {
      "includeFiles": "api/_documents/templates/**"
    },
    "api/doc-dl-human-resources.ts": {
      "includeFiles": "api/_documents/human-resources/**"
    },
    "api/doc-dl-health-safety.ts": {
      "includeFiles": "api/_documents/health-safety/**"
    },
    "api/doc-dl-commercial.ts": {
      "includeFiles": "api/_documents/commercial/**"
    },
    "api/doc-dl-technical.ts": {
      "includeFiles": "api/_documents/technical/**"
    },
    "api/doc-dl-manuals.ts": {
      "includeFiles": "api/_documents/manuals/**"
    },
    "api/doc-dl-tenders.ts": {
      "includeFiles": "api/_documents/tenders/**"
    },
    "api/doc-dl-environmental.ts": {
      "includeFiles": "api/_documents/environmental/**"
    },
    "api/doc-dl-subcontracting.ts": {
      "includeFiles": "api/_documents/subcontracting/**"
    }
  }
}
