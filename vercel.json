{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/about",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/about-ste",
      "destination": "/ai-tools",
      "permanent": true
    },
    {
      "source": "/ai-tools/rams",
      "destination": "/rams-generator",
      "permanent": true
    },
    {
      "source": "/ai-tools/coshh",
      "destination": "/coshh-generator",
      "permanent": true
    },
    {
      "source": "/ai-tools/compliance-chat",
      "destination": "/ai-tools/compliance-chatbot",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.teb-academy.com"
        }
      ],
      "destination": "https://teb-academy.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "eba-site.vercel.app"
        }
      ],
      "destination": "https://teb-academy.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ],
  "functions": {
    "api/generate-toolbox-talk.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/generate-rams.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/generate-coshh.ts": {
      "maxDuration": 60,
      "memory": 2048
    },
    "api/doc-dl-1.ts": {
      "includeFiles": "api/_documents/group-1/**"
    },
    "api/doc-dl-2.ts": {
      "includeFiles": "api/_documents/group-2/**"
    }
  }
}
