{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/about", "destination": "/our-story", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.teb-academy.com" }],
      "destination": "https://teb-academy.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/generate-toolbox-talk.ts": {
      "maxDuration": 60,
      "memory": 2048
    }
  }
}
