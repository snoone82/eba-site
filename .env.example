# EBA — environment variables (all optional; safe TODO placeholders are used when unset)
# Copy to .env.local for local dev, or set these in the Vercel project settings.
# Every value is a public, client-side URL (Vite inlines VITE_* at build time) —
# never put secret keys here. Stripe *secret* keys must NEVER be exposed client-side.

# Live Kajabi checkout URL. When unset, all "Join" CTAs show "Enrolment opens soon".
VITE_KAJABI_CHECKOUT_URL=

# Lead-magnet / enquiry form POST endpoint (Kajabi form action or webhook URL).
# When unset, the lead form shows "Form coming soon" and never fakes a submission.
VITE_FORM_ENDPOINT=

# Stripe *Payment Link* URLs (public links, not API keys) for the standalone AI tools.
VITE_STRIPE_OM_MANUAL=
VITE_STRIPE_COMPLIANCE_CHATBOT=

# Analytics
# - Vercel Web Analytics + Speed Insights: zero-config, enable in the Vercel dashboard.
# - Plausible (cookieless custom events): the data-domain + script live in client/index.html.
#   Set the site up at plausible.io with domain "eba.academy" (no env var needed).
