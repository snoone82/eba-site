# EBA — environment variables (all optional; safe TODO placeholders are used when unset)
# Copy to .env.local for local dev, or set these in the Vercel project settings.
# Every value is a public, client-side URL (Vite inlines VITE_* at build time) —
# never put secret keys here. Stripe *secret* keys must NEVER be exposed client-side.

# Live Kajabi checkout URL. When unset, all "Join" CTAs show "Enrolment opens soon".
VITE_KAJABI_CHECKOUT_URL=

# Lead-magnet / enquiry form POST endpoint (Kajabi form action or webhook URL).
# When unset, the lead form shows "Form coming soon" and never fakes a submission.
VITE_FORM_ENDPOINT=

# Stripe *Payment Link* URLs (public links, not API keys) for the standalone AI tools.
VITE_STRIPE_OM_MANUAL=
VITE_STRIPE_COMPLIANCE_CHATBOT=

# ── EBA Assistant (homepage chat) ────────────────────────────────────────────
# SERVER-SIDE SECRET — set in Vercel project settings, NOT with a VITE_ prefix and
# never committed. When set, /api/assistant answers via the Claude API; when unset,
# the assistant falls back to its built-in knowledge base.
# Also powers /api/generate-toolbox-talk (the free Toolbox Talk Generator) —
# without it that endpoint returns 501 and the tool page shows "Opening shortly."
ANTHROPIC_API_KEY=
# Optional: override the assistant endpoint the client calls (defaults to /api/assistant).
VITE_ASSISTANT_ENDPOINT=

# ── Toolbox Talk Generator (free tool) ───────────────────────────────────────
# SERVER-SIDE SECRETS — set in Vercel project settings, never committed.

# Postgres connection string (Neon, Vercel Postgres/Neon integration, Supabase, or
# any Postgres — the Neon serverless driver speaks the standard wire protocol over
# HTTP). Used for the lead log and per-email/IP rate limiting. When unset, rate
# limiting is skipped (fail-open) and no lead is recorded — fine for local dev,
# NOT recommended in production (nothing protects API spend from abuse).
DATABASE_URL=

# Resend API key (resend.com) — sends a copy of the generated PDF to the visitor's
# email. When unset, the tool still works: the PDF renders on screen and is
# downloadable, it just isn't emailed.
RESEND_API_KEY=
# Verified Resend sending identity, e.g. "The Engineering Business Academy <toolbox@eba.academy>".
RESEND_FROM_EMAIL=

# Analytics
# - Vercel Web Analytics + Speed Insights: zero-config, enable in the Vercel dashboard.
# - Plausible (cookieless custom events): the data-domain + script live in client/index.html.
#   Set the site up at plausible.io with domain "eba.academy" (no env var needed).
